use ::java::data::number_provider::RandomIntGenerator
use ::java::data::number_provider::IntNumberProviderRef
use ::java::data::number_provider::RandomValueBounds
use ::java::data::number_provider::FloatNumberProviderRef
use ::java::data::number_provider::IntRef
use ::java::data::number_provider::FloatRef
use ::java::data::loot::LootPoolEntry
use ::java::data::loot::LootEntryType
use ::java::data::loot::LootCondition
use ::java::util::DyeColor

dispatch minecraft:resource[villagerconfig:trade_table] to struct TradeTable {
	tiers: [TradeTier]
}

struct TradeTier {
	/// How much trader experience is required to unlock this tier.
	total_exp_required: int @ 0..,
	groups: [TradeGroup]
}

struct TradeGroup {
	/// How many trades will be selected from this group
	num_to_select: (
		#[until="1.17"] RandomIntGenerator |
		#[since="1.17"] IntNumberProviderRef |
	),
	trades: #[misode_collapse_items] [BehaviorTrade],
}

// see villagerconfig_loot.mcdoc
struct VC_LootPoolEntry {
	type: (
		#[until="1.16"] #[id] LootEntryType |
		#[since="1.16"] #[id="loot_pool_entry_type"] string |
	),
	...villagerconfig:loot_pool_entry[[type]],
}

struct BehaviorTrade {
	/// The first item that the player must give to the villager to trade.
	cost_a: VC_LootPoolEntry,
	/// An optional second item that the player must give to the villager to trade.
	cost_b?: VC_LootPoolEntry,
	/// The item that the villager will give to the player in exchange for the cost items.
	result: VC_LootPoolEntry,
	price_multiplier?: (
		#[until="1.17"] RandomValueBounds |
		#[since="1.17"] FloatNumberProviderRef |
	),
	trader_experience?: (
		#[until="1.17"] RandomIntGenerator |
		#[since="1.17"] IntNumberProviderRef |
	),
	/// The number of times the trade can be used before it is disabled.
	max_uses?: (
		#[until="1.17"] RandomIntGenerator |
		#[since="1.17"] IntNumberProviderRef |
	),
	conditions?: [LootCondition],
	reference_providers?: struct {
		[string]: (
			#[until="1.17"] RandomValueBounds |
			#[since="1.17"] FloatNumberProviderRef |
		),
	},
	reward_experience?: boolean,
	/// The "stored_enchantments" component on any item can affect the price
	/// If the offered enchanted book has the specified enchantments, the price will be affected by doubling the `additional_trade_cost` transient component.
	double_trade_price_enchantments?: (#[id(registry="enchantment",tags="allowed")] string | [#[id="enchantment"] string]),
}

struct Conditions {
	conditions?: [LootCondition],
}

// custom villagerconfig registry entries
dispatch minecraft:loot_function[villagerconfig:enchant_randomly] to struct VillagerConfigEnchantRandomly {
	include?: [#[id="enchantment"] string],
	exclude?: [#[id="enchantment"] string],
	min_level?: (
		#[until="1.17"] RandomIntGenerator |
		#[since="1.17"] IntNumberProviderRef |
	),
	max_level?: (
		#[until="1.17"] RandomIntGenerator |
		#[since="1.17"] IntNumberProviderRef |
	),
	...Conditions
}

dispatch minecraft:loot_function[villagerconfig:set_dye] to struct VillagerConfigSetDye {
	dye_colors?: [DyeColor],
	add?: boolean,
	...Conditions
}


// Legacy number providers
dispatch minecraft:number_provider[villagerconfig:add] to struct VillagerConfigAdd {
	addends: [LegacyNumberProvider],
}

dispatch minecraft:number_provider[villagerconfig:multiply] to struct VillagerConfigMultiply {
	factors: [LegacyNumberProvider],
}

dispatch minecraft:number_provider[villagerconfig:reference] to struct VillagerConfigReference {
	id: string,
}

// context_int
dispatch minecraft:context_int_provider[villagerconfig:add] to struct VillagerConfigAdd {
	addends: [IntRef],
}

dispatch minecraft:context_int_provider[villagerconfig:multiply] to struct VillagerConfigMultiply {
	factors: [IntRef],
}
dispatch minecraft:context_int_provider[villagerconfig:reference] to struct VillagerConfigReference {
	id: string,
}

// context_float
dispatch minecraft:context_float_provider[villagerconfig:add] to struct VillagerConfigAdd {
	addends: [FloatRef],
}

dispatch minecraft:context_float_provider[villagerconfig:multiply] to struct VillagerConfigMultiply {
	factors: [FloatRef],
}
dispatch minecraft:context_float_provider[villagerconfig:reference] to struct VillagerConfigReference {
	id: string,
}
